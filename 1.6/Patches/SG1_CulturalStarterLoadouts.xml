<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/GateRimSG1.Culture.CulturalPawnProfileDef[defName="SG1_Culture_TauriSGC"]/starterRules/li[requiredScenarioParts/li="SG1_StrandedSGTeamStartingGear"]</xpath>
        <value>
            <minimumBiologicalAge>20</minimumBiologicalAge>
            <requireViolenceCapable>true</requireViolenceCapable>
            <replaceStartingApparel>true</replaceStartingApparel>
            <apparelQuality>Normal</apparelQuality>
            <apparelSlots>
                <!-- Mandatory base layer. -->
                <li>
                    <selectionChance>1</selectionChance>
                    <options>
                        <li>
                            <apparel>Apparel_BasicShirt</apparel>
                            <stuff>Cloth</stuff>
                            <weight>1</weight>
                        </li>
                    </options>
                </li>
                <!-- Mandatory field pants select the shared uniform color. -->
                <li>
                    <selectionChance>1</selectionChance>
                    <variantGroup>SG1_FieldUniformColor</variantGroup>
                    <options>
                        <li>
                            <apparel>SG1_OliveSGTeamPants</apparel>
                            <weight>1</weight>
                            <variantKey>Olive</variantKey>
                        </li>
                        <li>
                            <apparel>SG1_BlackSGTeamPants</apparel>
                            <weight>1</weight>
                            <variantKey>Black</variantKey>
                        </li>
                        <li>
                            <apparel>SG1_DesertSGTeamPants</apparel>
                            <weight>1</weight>
                            <variantKey>Desert</variantKey>
                        </li>
                    </options>
                </li>
                <!-- Optional jacket reuses the pants color when selected. -->
                <li>
                    <selectionChance>0.75</selectionChance>
                    <variantGroup>SG1_FieldUniformColor</variantGroup>
                    <options>
                        <li>
                            <apparel>SG1_OliveSGTeamJacket</apparel>
                            <weight>1</weight>
                            <variantKey>Olive</variantKey>
                        </li>
                        <li>
                            <apparel>SG1_BlackSGTeamJacket</apparel>
                            <weight>1</weight>
                            <variantKey>Black</variantKey>
                        </li>
                        <li>
                            <apparel>SG1_DesertSGTeamJacket</apparel>
                            <weight>1</weight>
                            <variantKey>Desert</variantKey>
                        </li>
                    </options>
                </li>
                <li>
                    <selectionChance>1</selectionChance>
                    <options>
                        <li>
                            <apparel>SG1_SGTacticalBoots</apparel>
                            <weight>1</weight>
                        </li>
                    </options>
                </li>
                <li>
                    <selectionChance>1</selectionChance>
                    <options>
                        <li>
                            <apparel>SG1_SGTacticalGloves</apparel>
                            <weight>1</weight>
                        </li>
                    </options>
                </li>
                <li>
                    <selectionChance>1</selectionChance>
                    <options>
                        <li>
                            <apparel>SG1_SGTacticalVest</apparel>
                            <weight>1</weight>
                        </li>
                    </options>
                </li>
                <!-- Optional headgear: helmet or cap; the slot may also produce nothing. -->
                <li>
                    <selectionChance>0.6</selectionChance>
                    <options>
                        <li>
                            <apparel>SG1_SGTeamFieldHelmet</apparel>
                            <weight>1</weight>
                        </li>
                        <li>
                            <apparel>SG1_SGTeamFieldCap</apparel>
                            <weight>1</weight>
                        </li>
                    </options>
                </li>
            </apparelSlots>
        </value>
    </Operation>
</Patch>

<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!--
    Associate the Goa'uld world faction with its data-driven identity
    profile. The faction becomes visible in 0.2.1-dev while rank assignment
    remains intentionally separate.
    -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/FactionDef[defName="SG1_GoauldSystemLordPrototype"]</xpath>
        <value>
            <modExtensions>
                <li Class="GateRimSG1.Goauld.GoauldSystemLordDomainExtension">
                    <domain>SG1_GoauldSystemLordDomainPrototype</domain>
                </li>
            </modExtensions>
        </value>
    </Operation>
</Patch>

<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--
        First medical Jaffa Prim'ta implantation prototype.
        The worker restricts availability to compatible Jaffa who do not
        already carry SG1_JaffaPrimta.

        This version intentionally uses medicine as a procedural requirement.
        A dedicated physical immature-symbiote resource will be added later.
    -->
    <RecipeDef>
        <defName>SG1_ImplantJaffaPrimta</defName>
        <label>implant Jaffa Prim'ta</label>
        <description>Implant an immature Goa'uld symbiote into the abdominal pouch of a compatible Jaffa. This prototype validates the medical procedure and acquired Prim'ta effects. A dedicated larva resource and age ceremony will be introduced later.</description>
        <jobString>Implanting a Jaffa Prim'ta.</jobString>
        <workerClass>GateRimSG1.Jaffa.Recipe_ImplantJaffaPrimta</workerClass>
        <workAmount>900</workAmount>
        <effectWorking>Surgery</effectWorking>
        <soundWorking>Recipe_Surgery</soundWorking>
        <workSpeedStat>MedicalOperationSpeed</workSpeedStat>
        <workSkill>Medicine</workSkill>
        <workSkillLearnFactor>10</workSkillLearnFactor>
        <surgeryOutcomeEffect>SurgeryOutcomeBase</surgeryOutcomeEffect>
        <surgerySuccessChanceFactor>1</surgerySuccessChanceFactor>
        <deathOnFailedSurgeryChance>0.005</deathOnFailedSurgeryChance>
        <targetsBodyPart>false</targetsBodyPart>
        <humanlikeOnly>true</humanlikeOnly>
        <skillRequirements>
            <Medicine>4</Medicine>
        </skillRequirements>
        <ingredients>
            <li>
                <filter>
                    <categories>
                        <li>Medicine</li>
                    </categories>
                </filter>
                <count>1</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
            <categories>
                <li>Medicine</li>
            </categories>
        </fixedIngredientFilter>
        <recipeUsers>
            <li>Human</li>
        </recipeUsers>
    </RecipeDef>
</Defs>

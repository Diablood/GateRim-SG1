<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--
        Medical Jaffa Prim'ta implantation.

        Since 0.1.27-dev, the procedure consumes one physical SG1_PrimtaLarva
        in addition to one medicine unit. The worker still restricts
        availability to compatible Jaffa without an existing Prim'ta.
    -->
    <RecipeDef>
        <defName>SG1_ImplantJaffaPrimta</defName>
        <label>implant Jaffa Prim'ta</label>
        <description>Implant a physical immature Goa'uld symbiote larva into the abdominal pouch of a compatible Jaffa. The operation consumes one Prim'ta larva and one medicine. Age ceremonies, natural larva acquisition and dependency systems will be introduced later.</description>
        <jobString>Implanting a Jaffa Prim'ta larva.</jobString>
        <workerClass>GateRimSG1.Jaffa.Recipe_ImplantJaffaPrimta</workerClass>
        <workAmount>900</workAmount>
        <effectWorking>Surgery</effectWorking>
        <soundWorking>Recipe_Surgery</soundWorking>
        <workSpeedStat>MedicalOperationSpeed</workSpeedStat>
        <workSkill>Medicine</workSkill>
        <workSkillLearnFactor>10</workSkillLearnFactor>
        <surgeryOutcomeEffect>SurgeryOutcomeBase</surgeryOutcomeEffect>
        <surgerySuccessChanceFactor>1</surgerySuccessChanceFactor>
        <deathOnFailedSurgeryChance>0.005</deathOnFailedSurgeryChance>
        <targetsBodyPart>false</targetsBodyPart>
        <humanlikeOnly>true</humanlikeOnly>
        <skillRequirements>
            <Medicine>4</Medicine>
        </skillRequirements>
        <ingredients>
            <li>
                <filter>
                    <categories>
                        <li>Medicine</li>
                    </categories>
                </filter>
                <count>1</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>SG1_PrimtaLarva</li>
                    </thingDefs>
                </filter>
                <count>1</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
            <categories>
                <li>Medicine</li>
            </categories>
            <thingDefs>
                <li>SG1_PrimtaLarva</li>
            </thingDefs>
        </fixedIngredientFilter>
        <recipeUsers>
            <li>Human</li>
        </recipeUsers>
    </RecipeDef>
</Defs>

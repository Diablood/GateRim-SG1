<?xml version='1.0' encoding='utf-8'?>
<Defs>
    <RecipeDef>
        <defName>SG1_IncubatePrimtaLarva</defName>
        <label>mature Prim'ta larva</label>
        <description>Mature one queen-origin immature Prim'ta symbiote into a transportable larva for later Jaffa implantation. The basin consumes one physical immature symbiote and 10 units of raw meat nutrients while preserving the existing animal-handling work requirement and Animals skill 4 threshold.</description>
        <jobString>Maturing a Prim'ta larva with biological nutrients.</jobString>
        <requiredGiverWorkType>Handling</requiredGiverWorkType>
        <allowMixingIngredients>true</allowMixingIngredients>
        <workAmount>1800</workAmount>
        <workSkill>Animals</workSkill>
        <workSkillLearnFactor>0.4</workSkillLearnFactor>
        <skillRequirements>
            <Animals>4</Animals>
        </skillRequirements>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>SG1_ImmaturePrimtaSymbiote</li>
                    </thingDefs>
                </filter>
                <count>1</count>
            </li>
            <li>
                <filter>
                    <categories>
                        <li>MeatRaw</li>
                    </categories>
                </filter>
                <count>10</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
            <thingDefs>
                <li>SG1_ImmaturePrimtaSymbiote</li>
            </thingDefs>
            <categories>
                <li>MeatRaw</li>
            </categories>
        </fixedIngredientFilter>
        <products>
            <SG1_PrimtaLarva>1</SG1_PrimtaLarva>
        </products>
        <researchPrerequisite>SG1_GoauldBiotechnology</researchPrerequisite>
    </RecipeDef>
</Defs>
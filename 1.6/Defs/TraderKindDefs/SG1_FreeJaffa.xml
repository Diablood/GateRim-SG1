<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--
    Free Jaffa clan-supply caravan.

    The inventory supports an armed resistance without becoming a universal
    merchant. Exact resources keep the supply role predictable, broad weapon
    and armor generators let the caravan buy human military equipment, and
    explicit GateRim items preserve a visible Jaffa identity.
    -->
    <TraderKindDef>
        <defName>SG1_Caravan_FreeJaffaClanSupplies</defName>
        <label>Free Jaffa clan supply convoy</label>
        <stockGenerators>
            <!-- Limited purchasing budget. -->
            <li Class="StockGenerator_SingleDef">
                <thingDef>Silver</thingDef>
                <countRange>850~1300</countRange>
            </li>

            <!-- Durable provisions and field medicine. -->
            <li Class="StockGenerator_SingleDef">
                <thingDef>MealSurvivalPack</thingDef>
                <countRange>10~24</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>Pemmican</thingDef>
                <countRange>20~55</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>MedicineHerbal</thingDef>
                <countRange>6~16</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>MedicineIndustrial</thingDef>
                <countRange>4~10</countRange>
            </li>

            <!-- Strategic repair and production supplies. -->
            <li Class="StockGenerator_SingleDef">
                <thingDef>Steel</thingDef>
                <countRange>90~190</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>Plasteel</thingDef>
                <countRange>15~45</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>ComponentIndustrial</thingDef>
                <countRange>10~22</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>ComponentSpacer</thingDef>
                <countRange>-6~2</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>Chemfuel</thingDef>
                <countRange>35~90</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>Cloth</thingDef>
                <countRange>35~90</countRange>
            </li>

            <!-- Human weapons acquired through exchange or salvage. -->
            <li Class="StockGenerator_Category">
                <categoryDef>WeaponsRanged</categoryDef>
                <maxTechLevelGenerate>Industrial</maxTechLevelGenerate>
                <thingDefCountRange>2~4</thingDefCountRange>
                <countRange>1~1</countRange>
            </li>
            <li Class="StockGenerator_Category">
                <categoryDef>WeaponsMelee</categoryDef>
                <maxTechLevelGenerate>Industrial</maxTechLevelGenerate>
                <thingDefCountRange>1~2</thingDefCountRange>
                <countRange>1~1</countRange>
            </li>
            <li Class="StockGenerator_MarketValue">
                <tradeTag>Armor</tradeTag>
                <maxTechLevelGenerate>Industrial</maxTechLevelGenerate>
                <countRange>1~3</countRange>
            </li>

            <!-- Jaffa equipment remains limited and partly recovered. -->
            <li Class="StockGenerator_SingleDef">
                <thingDef>SG1_MatokStaff</thingDef>
                <countRange>0~2</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>SG1_ZatnikTel</thingDef>
                <countRange>-5~1</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>SG1_JaffaLightArmor</thingDef>
                <countRange>0~2</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>SG1_JaffaHeavyArmor</thingDef>
                <countRange>-3~1</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>SG1_JaffaGauntlets</thingDef>
                <countRange>0~2</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>SG1_JaffaReinforcedBoots</thingDef>
                <countRange>0~2</countRange>
            </li>
            <li Class="StockGenerator_SingleDef">
                <thingDef>SG1_JaffaDeployedHelmet</thingDef>
                <countRange>-2~1</countRange>
            </li>

            <!-- Buy military equipment beyond the generated industrial stock. -->
            <li Class="StockGenerator_BuyTradeTag">
                <tag>HiTechArmor</tag>
            </li>
        </stockGenerators>
    </TraderKindDef>
</Defs>

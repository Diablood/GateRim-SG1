<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--
        Prototype implementation:
        Jaffa are represented as a non-inheritable Biotech xenotype while the
        dedicated symbiote system is designed. The final implementation may
        replace part of this definition with a Hediff and C# logic.

        No Body_* gene is imposed here. Jaffa appearance should remain varied;
        their enhanced physical baseline is represented by SG1_JaffaPhysiology.
    -->
    <XenotypeDef>
        <defName>SG1_Jaffa</defName>
        <label>Jaffa</label>
        <description>Jaffa are human warriors altered to carry an immature Goa'uld symbiote. Their enhanced strength, resilience, immune response and slower aging make them formidable soldiers. Their physical advantages do not impose a single visible body shape. This initial xenotype is a gameplay foundation; symbiote dependency will be implemented separately.</description>
        <descriptionShort>Human warriors enhanced by an immature Goa'uld symbiote.</descriptionShort>
        <!-- Temporary vanilla icon until dedicated Jaffa artwork is added. -->
        <iconPath>UI/Icons/Xenotypes/Hussar</iconPath>
        <inheritable>false</inheritable>
        <combatPowerFactor>1.4</combatPowerFactor>
        <genes>
            <li>SG1_JaffaPhysiology</li>
            <li>SG1_JaffaLongevity</li>
            <li>AptitudeStrong_Melee</li>
            <li>Immunity_Strong</li>
            <li>MeleeDamage_Strong</li>
            <li>Pain_Reduced</li>
            <li>Robust</li>
            <li>WoundHealing_Fast</li>
            <li>Superclotting</li>
            <li>StrongStomach</li>
        </genes>
    </XenotypeDef>
</Defs>

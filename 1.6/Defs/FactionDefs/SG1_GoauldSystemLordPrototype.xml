<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--
    First playable Goa'uld world-faction baseline.

    One hostile world faction is generated at game start as a practical
    RimWorld abstraction for several Goa'uld System Lord domains. A reduced
    settlement-generation weight keeps its world presence visible but limited.

    Generic vanilla faction selection remains blocked through raidsForbidden.
    Natural Goa'uld attacks use the dedicated low-frequency
    SG1_GoauldJaffaNaturalRaid incident so only the validated direct-assault
    doctrine is enabled in normal play during this milestone.
    -->
    <FactionDef>
        <defName>SG1_GoauldSystemLordPrototype</defName>
        <label>Goa'uld System Lord domains</label>
        <description>A hostile world-faction abstraction for territories controlled by Goa'uld System Lords. The first playable baseline generates a limited number of visible settlements and enables rare direct-assault Jaffa raids through a dedicated incident. Traders, military aid, quest sites, natural abduction raids and natural destruction raids remain disabled.</description>
        <fixedName>Goa'uld System Lord domains</fixedName>
        <pawnsPlural>Goa'uld subjects</pawnsPlural>
        <pawnSingular>Goa'uld subject</pawnSingular>
        <!--
        Provisional leader baseline: until true persistent Goa'uld host profiles
        exist, visible domains are represented by a generated senior Jaffa
        commander rather than an incomplete fake System Lord host.
        -->
        <leaderTitle>domain Jaffa commander</leaderTitle>
        <basicMemberKind>SG1_GoauldJaffaWarrior</basicMemberKind>
        <fixedLeaderKinds>
            <li>SG1_GoauldJaffaGuard</li>
        </fixedLeaderKinds>
        <leaderForceGenerateNewPawn>true</leaderForceGenerateNewPawn>
        <humanlikeFaction>true</humanlikeFaction>
        <hidden>false</hidden>
        <listOrderPriority>8</listOrderPriority>
        <techLevel>Spacer</techLevel>
        <backstoryFilters>
            <li>
                <categories>
                    <li>Offworld</li>
                </categories>
            </li>
        </backstoryFilters>
        <permanentEnemy>true</permanentEnemy>
        <naturalEnemy>true</naturalEnemy>
        <requiredCountAtGameStart>1</requiredCountAtGameStart>

        <!--
        RimWorld 1.6 world-creation UI fields.
        The faction appears once by default. Players may add more instances
        manually, like configurable vanilla factions.
        -->
        <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
        <startingCountAtWorldCreation>1</startingCountAtWorldCreation>
        <configurationListOrderPriority>8</configurationListOrderPriority>
        <displayInFactionSelection>true</displayInFactionSelection>

        <settlementGenerationWeight>0.35</settlementGenerationWeight>
        <factionIconPath>World/WorldObjects/Expanding/PirateOutpost</factionIconPath>
        <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
        <factionNameMaker>NamerFactionPirate</factionNameMaker>
        <settlementNameMaker>NamerSettlementPirate</settlementNameMaker>
        <colorSpectrum>
            <li>(0.60, 0.43, 0.10)</li>
            <li>(0.85, 0.68, 0.20)</li>
        </colorSpectrum>
        <allowedArrivalTemperatureRange>
            <min>-40</min>
            <max>55</max>
        </allowedArrivalTemperatureRange>

        <!--
        Keep generic vanilla enemy-raid selection disabled. Dedicated natural
        and controlled incidents set the faction explicitly and force the
        already validated ImmediateAttack path.
        -->
        <raidsForbidden>true</raidsForbidden>
        <canSiege>false</canSiege>
        <canStageAttacks>false</canStageAttacks>
        <canRequestTraders>false</canRequestTraders>
        <canRequestMilitaryAid>false</canRequestMilitaryAid>
        <canGenerateQuestSites>false</canGenerateQuestSites>

        <!--
        Current baseline: the faction generates Jaffa servants only.
        Declare SG1_Jaffa explicitly so the Create World summary does not
        misleadingly report 100% baseliners.

        True Goa'uld hosts remain a later dedicated milestone: adding only the
        SG1_GoauldHost xenotype here would create incomplete hosts without a
        persistent implanted symbiote identity.
        -->
        <xenotypeSet>
            <xenotypeChances>
                <SG1_Jaffa>1</SG1_Jaffa>
            </xenotypeChances>
        </xenotypeSet>

        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(0, 35)</li>
                <li>(70, 50)</li>
                <li>(700, 100)</li>
                <li>(1300, 150)</li>
                <li>(100000, 10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>
        <raidLootValueFromPointsCurve>
            <points>
                <li>(35, 15)</li>
                <li>(100, 120)</li>
                <li>(1000, 500)</li>
                <li>(2000, 800)</li>
                <li>(4000, 1000)</li>
            </points>
        </raidLootValueFromPointsCurve>
        <pawnGroupMakers>
            <li>
                <kindDef>Combat</kindDef>
                <commonality>1</commonality>
                <options>
                    <SG1_GoauldJaffaWarrior>4</SG1_GoauldJaffaWarrior>
                    <SG1_GoauldJaffaGuard>1</SG1_GoauldJaffaGuard>
                </options>
            </li>
            <li>
                <kindDef>Settlement</kindDef>
                <commonality>1</commonality>
                <options>
                    <SG1_GoauldJaffaWarrior>4</SG1_GoauldJaffaWarrior>
                    <SG1_GoauldJaffaGuard>1</SG1_GoauldJaffaGuard>
                </options>
            </li>
        </pawnGroupMakers>
    </FactionDef>
</Defs>

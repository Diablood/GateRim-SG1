<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--
    First hostile Goa'uld System Lord faction foundation.
    This faction remains hidden and is not generated automatically.
    It now exposes developer-testable Goa'uld-aligned Jaffa PawnKindDefs
    through a nested Combat pawn-group profile. Natural settlements,
    raids and traders remain disabled.
    -->
    <FactionDef>
        <defName>SG1_GoauldSystemLordPrototype</defName>
        <label>Goa'uld System Lord domain</label>
        <description>A hidden hostile foundation definition for a Goa'uld System Lord domain. This prototype establishes the faction identity and permanent hostility, exposes the first Goa'uld-aligned Jaffa servants through a developer-testable Combat pawn-group profile, and still avoids generating settlements, natural raids or traders. Future milestones will add equipment, visual markings and world presence.</description>
        <fixedName>prototype Goa'uld System Lord domain</fixedName>
        <pawnsPlural>Goa'uld subjects</pawnsPlural>
        <pawnSingular>Goa'uld subject</pawnSingular>
        <leaderTitle>System Lord</leaderTitle>
        <humanlikeFaction>true</humanlikeFaction>
        <hidden>true</hidden>
        <techLevel>Spacer</techLevel>
        <backstoryFilters>
            <li>
                <categories>
                    <li>Offworld</li>
                </categories>
            </li>
        </backstoryFilters>
        <permanentEnemy>true</permanentEnemy>
        <naturalEnemy>true</naturalEnemy>
        <canMakeRandomly>false</canMakeRandomly>
        <requiredCountAtGameStart>0</requiredCountAtGameStart>
        <maxCountAtGameStart>0</maxCountAtGameStart>
        <settlementGenerationWeight>0</settlementGenerationWeight>
        <raidsForbidden>true</raidsForbidden>
        <canRequestTraders>false</canRequestTraders>
        <canRequestMilitaryAid>false</canRequestMilitaryAid>
        <canGenerateQuestSites>false</canGenerateQuestSites>
        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(0, 35)</li>
                <li>(70, 50)</li>
                <li>(700, 100)</li>
                <li>(1300, 150)</li>
                <li>(100000, 10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>
        <raidLootValueFromPointsCurve>
            <points>
                <li>(35, 15)</li>
                <li>(100, 120)</li>
                <li>(1000, 500)</li>
                <li>(2000, 800)</li>
                <li>(4000, 1000)</li>
            </points>
        </raidLootValueFromPointsCurve>
        <pawnGroupMakers>
            <li>
                <kindDef>Combat</kindDef>
                <commonality>1</commonality>
                <options>
                    <SG1_GoauldJaffaWarrior>4</SG1_GoauldJaffaWarrior>
                    <SG1_GoauldJaffaGuard>1</SG1_GoauldJaffaGuard>
                </options>
            </li>
        </pawnGroupMakers>
    </FactionDef>
</Defs>

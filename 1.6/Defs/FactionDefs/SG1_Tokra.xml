<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--
    Persistent hidden Tok'ra world-presence anchor.

    New worlds generate exactly one hidden faction instance. It creates no
    settlement, remains absent from configurable world-creation lists and
    never participates in natural raids.

    GameComponent_TokraWorldPresenceInitializer creates the same hidden
    presence on older saves that predate this milestone.
    -->
    <FactionDef>
        <defName>SG1_Tokra</defName>
        <label>Tok'ra</label>
        <description>A persistent but hidden world-presence anchor for the Tok'ra resistance. The Tok'ra seek voluntary hosts and oppose Goa'uld domination while operating through clandestine cells rather than territorial settlements. One hidden faction instance exists in each game and is reused by peaceful visits, therapeutic opportunities and medical-support deliveries. Settlements, traders, raids and configurable world-creation entries remain disabled.</description>
        <fixedName>Tok'ra</fixedName>
        <pawnsPlural>Tok'ra</pawnsPlural>
        <pawnSingular>Tok'ra</pawnSingular>
        <leaderTitle>cell coordinator</leaderTitle>
        <humanlikeFaction>true</humanlikeFaction>
        <hidden>true</hidden>
        <techLevel>Spacer</techLevel>
        <backstoryFilters>
            <li>
                <categories>
                    <li>Offworld</li>
                </categories>
            </li>
        </backstoryFilters>
        <permanentEnemy>false</permanentEnemy>
        <naturalEnemy>false</naturalEnemy>
        <canMakeRandomly>false</canMakeRandomly>

        <!--
        One hidden presence is generated for new worlds. It remains absent
        from the configurable faction-selection UI.
        -->
        <requiredCountAtGameStart>1</requiredCountAtGameStart>
        <maxCountAtGameStart>1</maxCountAtGameStart>
        <settlementGenerationWeight>0</settlementGenerationWeight>

        <!-- Clandestine baseline: no territorial or military systems yet. -->
        <raidsForbidden>true</raidsForbidden>
        <canSiege>false</canSiege>
        <canStageAttacks>false</canStageAttacks>
        <canRequestTraders>false</canRequestTraders>
        <canRequestMilitaryAid>false</canRequestMilitaryAid>
        <canGenerateQuestSites>false</canGenerateQuestSites>

        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(0, 35)</li>
                <li>(70, 50)</li>
                <li>(700, 100)</li>
                <li>(1300, 150)</li>
                <li>(100000, 10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>
        <raidLootValueFromPointsCurve>
            <points>
                <li>(35, 15)</li>
                <li>(100, 120)</li>
                <li>(1000, 500)</li>
                <li>(2000, 800)</li>
                <li>(4000, 1000)</li>
            </points>
        </raidLootValueFromPointsCurve>
        <pawnGroupMakers>
            <li>
                <kindDef>Combat</kindDef>
                <commonality>1</commonality>
                <options>
                    <SG1_TokraVoluntaryHost>1</SG1_TokraVoluntaryHost>
                </options>
            </li>
            <li>
                <kindDef>Peaceful</kindDef>
                <commonality>1</commonality>
                <options>
                    <SG1_TokraVoluntaryHost>1</SG1_TokraVoluntaryHost>
                </options>
            </li>
        </pawnGroupMakers>
    </FactionDef>
</Defs>

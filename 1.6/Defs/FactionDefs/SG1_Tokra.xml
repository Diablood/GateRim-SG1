<?xml version='1.0' encoding='utf-8'?>
<Defs>
    <FactionDef>
        <defName>SG1_Tokra</defName>
        <label>Tok'ra</label>
        <description>A hidden foundation definition for the Tok'ra resistance. The Tok'ra seek voluntary hosts and oppose Goa'uld domination. This prototype can create a hidden Tok'ra faction instance when the developer-triggered peaceful visitor incident is used. Settlements, random storyteller visits, traders, raids and world-faction generation remain disabled.</description>
        <fixedName>Tok'ra</fixedName>
        <pawnsPlural>Tok'ra</pawnsPlural>
        <pawnSingular>Tok'ra</pawnSingular>
        <humanlikeFaction>true</humanlikeFaction>
        <hidden>true</hidden>
        <techLevel>Spacer</techLevel>
        <backstoryFilters>
            <li>
                <categories>
                    <li>Offworld</li>
                </categories>
            </li>
        </backstoryFilters>
        <permanentEnemy>false</permanentEnemy>
        <canMakeRandomly>false</canMakeRandomly>
        <requiredCountAtGameStart>0</requiredCountAtGameStart>
        <maxCountAtGameStart>0</maxCountAtGameStart>
        <settlementGenerationWeight>0</settlementGenerationWeight>
        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(0, 35)</li>
                <li>(70, 50)</li>
                <li>(700, 100)</li>
                <li>(1300, 150)</li>
                <li>(100000, 10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>
        <raidLootValueFromPointsCurve>
            <points>
                <li>(35, 15)</li>
                <li>(100, 120)</li>
                <li>(1000, 500)</li>
                <li>(2000, 800)</li>
                <li>(4000, 1000)</li>
            </points>
        </raidLootValueFromPointsCurve>
        <pawnGroupMakers>
            <li>
                <kindDef>Combat</kindDef>
                <commonality>1</commonality>
                <options>
                    <SG1_TokraVoluntaryHost>1</SG1_TokraVoluntaryHost>
                </options>
            </li>
            <li>
                <kindDef>Peaceful</kindDef>
                <commonality>1</commonality>
                <options>
                    <SG1_TokraVoluntaryHost>1</SG1_TokraVoluntaryHost>
                </options>
            </li>
        </pawnGroupMakers>
    </FactionDef>
</Defs>
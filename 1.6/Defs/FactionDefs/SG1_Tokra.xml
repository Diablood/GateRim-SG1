<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--
    Optional non-territorial Tok'ra world faction.

    The faction is shown in the world-faction selection like the vanilla
    mechanoid and insect factions. It is selected once by default, can be
    removed by the player, creates no settlements and remains hidden from the
    ordinary in-game diplomacy list.

    When the player removes it, GateRim SG-1 does not recreate it at runtime:
    Tok'ra incidents, the introduction arc and recurrent operations remain
    unavailable for that save.
    -->
    <FactionDef>
        <defName>SG1_Tokra</defName>
        <label>Tok'ra</label>
        <description>A clandestine Tok'ra resistance network operating without territorial settlements. This faction is selected once by default during world creation but may be removed by the player. Removing it disables Tok'ra contacts, incidents, the introduction questline and recurrent operations for that game while leaving the rest of GateRim SG-1 available.</description>
        <fixedName>Tok'ra</fixedName>
        <pawnsPlural>Tok'ra</pawnsPlural>
        <pawnSingular>Tok'ra</pawnSingular>
        <leaderTitle>cell coordinator</leaderTitle>
        <humanlikeFaction>true</humanlikeFaction>
        <hidden>true</hidden>
        <techLevel>Spacer</techLevel>
        <backstoryFilters>
            <li>
                <categories>
                    <li>Offworld</li>
                </categories>
            </li>
        </backstoryFilters>
        <permanentEnemy>false</permanentEnemy>
        <naturalEnemy>false</naturalEnemy>

        <!--
        The player-facing world list controls whether the Tok'ra exist.
        A single instance is selected by default, zero is allowed, and no
        mandatory hidden fallback is generated outside that selection.
        -->
        <requiredCountAtGameStart>0</requiredCountAtGameStart>
        <displayInFactionSelection>true</displayInFactionSelection>
        <startingCountAtWorldCreation>1</startingCountAtWorldCreation>
        <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
        <configurationListOrderPriority>10</configurationListOrderPriority>
        <factionIconPath>World/WorldObjects/Expanding/SG1_Tokra</factionIconPath>
        <settlementGenerationWeight>0</settlementGenerationWeight>

        <!-- Clandestine baseline: no territorial or military systems. -->
        <raidsForbidden>true</raidsForbidden>
        <canSiege>false</canSiege>
        <canStageAttacks>false</canStageAttacks>
        <canRequestTraders>false</canRequestTraders>
        <canRequestMilitaryAid>false</canRequestMilitaryAid>
        <canGenerateQuestSites>false</canGenerateQuestSites>

        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(0, 35)</li>
                <li>(70, 50)</li>
                <li>(700, 100)</li>
                <li>(1300, 150)</li>
                <li>(100000, 10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>
        <raidLootValueFromPointsCurve>
            <points>
                <li>(35, 15)</li>
                <li>(100, 120)</li>
                <li>(1000, 500)</li>
                <li>(2000, 800)</li>
                <li>(4000, 1000)</li>
            </points>
        </raidLootValueFromPointsCurve>
        <pawnGroupMakers>
            <li>
                <kindDef>Combat</kindDef>
                <commonality>1</commonality>
                <options>
                    <SG1_TokraVoluntaryHost>1</SG1_TokraVoluntaryHost>
                </options>
            </li>
            <li>
                <kindDef>Peaceful</kindDef>
                <commonality>1</commonality>
                <options>
                    <SG1_TokraVoluntaryHost>1</SG1_TokraVoluntaryHost>
                </options>
            </li>
        </pawnGroupMakers>
    </FactionDef>
</Defs>

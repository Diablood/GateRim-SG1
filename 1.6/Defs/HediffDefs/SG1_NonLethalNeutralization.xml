<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef>
        <defName>SG1_NonLethalNeutralization</defName>
        <label>temporary neuromuscular inhibition</label>
        <description>A short-lived loss of motor control caused by an experimental Tok'ra hypodermic compound. The target remains conscious, but its legs are temporarily unable to support movement.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>true</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>600~900</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
        <stages>
            <li>
                <label>legs numbed</label>
                <capMods>
                    <li>
                        <capacity>Moving</capacity>
                        <setMax>0</setMax>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>SG1_BolasRestraint</defName>
        <label>temporary bolas restraint</label>
        <description>Weighted cords are wrapped around the target's legs, preventing movement until the restraint loosens or is removed.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>true</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>600~900</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
        <stages>
            <li>
                <label>legs entangled</label>
                <capMods>
                    <li>
                        <capacity>Moving</capacity>
                        <setMax>0</setMax>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>
</Defs>

<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef>
        <defName>SG1_KaraKeshParalysisHold</defName>
        <label>kara kesh paralysis hold</label>
        <description>A maintained neural lock from a Goa'uld kara kesh suppresses voluntary movement and most manipulation. The effect ends early if the wearer can no longer sustain range, line of sight, biological activation or control of the device.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>true</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <comps>
            <li Class="GateRimSG1.Goauld.HediffCompProperties_KaraKeshParalysisHold">
                <validationIntervalTicks>15</validationIntervalTicks>
            </li>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>600~600</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
        <stages>
            <li>
                <label>maintained paralysis</label>
                <capMods>
                    <li>
                        <capacity>Moving</capacity>
                        <setMax>0</setMax>
                    </li>
                    <li>
                        <capacity>Manipulation</capacity>
                        <postFactor>0.1</postFactor>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>
</Defs>

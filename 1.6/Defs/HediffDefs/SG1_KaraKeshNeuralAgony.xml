<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef>
        <defName>SG1_KaraKeshNeuralAgony</defName>
        <label>kara kesh neural agony</label>
        <description>A focused neural assault from a Goa'uld kara kesh floods the target's nervous system with acute pain and cognitive disruption. The effect is temporary and does not directly paralyze the victim.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>true</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>600~600</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
        <stages>
            <li>
                <label>acute neural overload</label>
                <painOffset>0.45</painOffset>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <postFactor>0.8</postFactor>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>
</Defs>

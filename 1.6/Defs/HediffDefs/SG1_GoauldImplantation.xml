<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--
        XML-only prototype:
        This temporary Hediff represents the critical period immediately after
        a Goa'uld symbiote enters a humanoid host.

        It can currently be added through developer mode for medical and UI
        tests. The future C# implantation workflow will apply it automatically,
        then convert the target into an active Goa'uld host if the process is
        not interrupted.
    -->
    <HediffDef>
        <defName>SG1_GoauldRecentImplantation</defName>
        <label>recent Goa'uld implantation</label>
        <description>An adult Goa'uld symbiote has recently entered this host and is attaching itself to the nervous system. The victim suffers a painful critical phase while the parasite attempts to establish control. This prototype state expires after one in-game day; automatic conversion into an active Goa'uld host will be implemented later.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>true</isBad>
        <stages>
            <li>
                <label>critical implantation phase</label>
                <painOffset>0.15</painOffset>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>60000</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
    </HediffDef>
</Defs>

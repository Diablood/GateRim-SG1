<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--
        Progressive biological deficiency for compatible Jaffa who have reached
        puberty without an implanted immature symbiote.

        Severity is advanced by GameComponent_JaffaPrimtaDependency.
        Tretonin substitution and direct lethal consequences remain future work.
    -->
    <HediffDef>
        <defName>SG1_JaffaPrimtaDependency</defName>
        <label>Prim'ta deficiency</label>
        <description>This Jaffa has reached puberty without an implanted Prim'ta. The absence of an immature Goa'uld symbiote is progressively weakening the host's immune system and recovery. Implanting a Prim'ta removes this deficiency. Tretonin substitution is not implemented yet.</description>
        <isBad>true</isBad>
        <stages>
            <li>
                <label>early immune decline</label>
                <statFactors>
                    <ImmunityGainSpeed>0.85</ImmunityGainSpeed>
                </statFactors>
            </li>
            <li>
                <minSeverity>0.25</minSeverity>
                <label>moderate immune decline</label>
                <statFactors>
                    <ImmunityGainSpeed>0.65</ImmunityGainSpeed>
                    <InjuryHealingFactor>0.9</InjuryHealingFactor>
                </statFactors>
            </li>
            <li>
                <minSeverity>0.5</minSeverity>
                <label>advanced immune decline</label>
                <statFactors>
                    <ImmunityGainSpeed>0.4</ImmunityGainSpeed>
                    <InjuryHealingFactor>0.7</InjuryHealingFactor>
                </statFactors>
            </li>
            <li>
                <minSeverity>0.75</minSeverity>
                <label>critical immune decline</label>
                <statFactors>
                    <ImmunityGainSpeed>0.15</ImmunityGainSpeed>
                    <InjuryHealingFactor>0.45</InjuryHealingFactor>
                </statFactors>
            </li>
        </stages>
    </HediffDef>
</Defs>

<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef>
        <defName>SG1_GoauldHealingBraceletFatigue</defName>
        <label>healing-device exhaustion</label>
        <description>Channeling a Goa'uld healing device has temporarily exhausted the wearer's nervous system and fine motor control.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>true</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>12000~12000</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
        <stages>
            <li>
                <label>neural exhaustion</label>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <postFactor>0.9</postFactor>
                    </li>
                    <li>
                        <capacity>Manipulation</capacity>
                        <postFactor>0.85</postFactor>
                    </li>
                    <li>
                        <capacity>Moving</capacity>
                        <postFactor>0.9</postFactor>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>
</Defs>

<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--
        Persistent acquired state representing an implanted immature Goa'uld
        symbiote in a compatible Jaffa pouch.

        Since 0.1.26-dev, the state can be applied through a medical operation.
        Future milestones will add a physical larva resource, age ceremony,
        dependency after removal and tretonin substitution.
    -->
    <HediffDef>
        <defName>SG1_JaffaPrimta</defName>
        <label>Prim'ta symbiote</label>
        <description>An immature Goa'uld symbiote resides in this Jaffa's abdominal pouch. It supports the host's immune system, accelerates recovery, reduces the impact of pain, improves resilience and extends lifespan. This acquired state can be applied through the Jaffa Prim'ta implantation procedure.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>false</isBad>
        <stages>
            <li>
                <label>immature symbiote support</label>
                <painFactor>0.85</painFactor>
                <statFactors>
                    <ImmunityGainSpeed>1.5</ImmunityGainSpeed>
                    <InjuryHealingFactor>1.5</InjuryHealingFactor>
                    <IncomingDamageFactor>0.9</IncomingDamageFactor>
                    <LifespanFactor>1.5</LifespanFactor>
                </statFactors>
            </li>
        </stages>
        <comps>
            <li Class="GateRimSG1.Jaffa.HediffCompProperties_JaffaPrimta" />
        </comps>
    </HediffDef>
</Defs>

<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--
    Rare natural access to the existing Goa'uld queen production loop.

    The worker gives the player one escaped queen only while no living
    player-controlled queen exists on a map or in a caravan. The queen's
    persistent three-day extraction cooldown and the assisted-maturation
    nutrient cost control later production.
    -->
    <IncidentDef>
        <defName>SG1_GoauldQueenArrival</defName>
        <label>escaped Goa'uld queen</label>
        <workerClass>GateRimSG1.Goauld.IncidentWorker_GoauldQueenArrival</workerClass>
        <category>Misc</category>
        <targetTags>
            <li>Map_PlayerHome</li>
        </targetTags>
        <baseChance>0.015</baseChance>
        <earliestDay>45</earliestDay>
        <minRefireDays>90</minRefireDays>
        <requireColonistsPresent>true</requireColonistsPresent>
        <letterLabel>Escaped Goa'uld queen</letterLabel>
        <letterText>A Goa'uld queen separated from its former keepers has reached the colony. Exhausted and unable to survive alone, it has accepted the protection and control of your handlers. While it remains under your control, the queen can rarely provide immature Prim'ta symbiotes for assisted maturation, but each extraction requires several days of recovery.</letterText>
        <letterDef>PositiveEvent</letterDef>
    </IncidentDef>
</Defs>

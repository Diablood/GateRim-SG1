<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--
    Consumes one stored Tok'ra safehouse lead and resolves it as a modest
    medical cache on the current colony map.

    This remains below true world-site complexity: no world object, generated
    map, visitor group, trader, recruitment, military aid or raid.
    -->
    <IncidentDef>
        <defName>SG1_TokraSafehouseLeadCache</defName>
        <label>Tok'ra safehouse lead cache</label>
        <workerClass>GateRimSG1.Goauld.IncidentWorker_TokraSafehouseLeadCache</workerClass>
        <category>Misc</category>
        <targetTags>
            <li>Map_PlayerHome</li>
        </targetTags>
        <baseChance>0.006</baseChance>
        <earliestDay>60</earliestDay>
        <minRefireDays>45</minRefireDays>
        <requireColonistsPresent>true</requireColonistsPresent>
        <letterLabel>Tok'ra safehouse lead resolved</letterLabel>
        <letterText>Your colonists have decoded enough of a stored Tok'ra safehouse lead to recover a small medical cache. The coordinates did not reveal a visitable safehouse, but they led to {TRETONINCOUNT} tretonin dose(s) and {MEDICINECOUNT} medicine unit(s). Remaining safehouse leads: {LEADCOUNT}/{LEADMAX}.</letterText>
        <letterDef>PositiveEvent</letterDef>
    </IncidentDef>
</Defs>

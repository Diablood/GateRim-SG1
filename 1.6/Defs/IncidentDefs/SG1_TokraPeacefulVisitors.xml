<?xml version="1.0" encoding="utf-8"?>

<Defs>
    <!--
    Low-frequency natural Tok'ra visitor incident.

    The Tok'ra faction remains hidden and disconnected from normal world
    generation. Developer tools remain available for controlled tests.
    -->
    <IncidentDef>
        <defName>SG1_TokraPeacefulVisitors</defName>
        <label>Tok'ra peaceful visitors</label>
        <workerClass>GateRimSG1.Goauld.IncidentWorker_TokraPeacefulVisitors</workerClass>
        <category>Misc</category>
        <targetTags>
            <li>Map_PlayerHome</li>
        </targetTags>
        <baseChance>0.10</baseChance>
        <earliestDay>15</earliestDay>
        <minRefireDays>30</minRefireDays>
        <requireColonistsPresent>true</requireColonistsPresent>
        <letterLabel>Peaceful Tok'ra visitors</letterLabel>
        <letterText>A small Tok'ra team has arrived peacefully near the colony. The visitors are not traders, but their presence may foreshadow future cooperation.</letterText>
        <letterDef>NeutralEvent</letterDef>
    </IncidentDef>
</Defs>

<?xml version='1.0' encoding='utf-8'?>
<Defs>
    <ThingDef ParentName="AnimalThingBase">
        <defName>SG1_TokraSymbiote</defName>
        <label>Tok'ra symbiote</label>
        <description>An adult Tok'ra symbiote outside a host. Unlike a hostile Goa'uld parasite, this symbiote does not hunt humanoids, cannot use forced implantation and cannot start a Goa'uld ritual implantation. Select it and choose voluntary implantation to target a nearby player-controlled humanoid who will serve as a consenting host. The same persistent Tok'ra identity survives implantation, conversion, save loading and extraction.</description>
        <statBases>
            <MoveSpeed>4.8</MoveSpeed>
            <MarketValue>250</MarketValue>
            <ComfyTemperatureMin>0</ComfyTemperatureMin>
            <ComfyTemperatureMax>45</ComfyTemperatureMax>
            <LeatherAmount>0</LeatherAmount>
            <MeatAmount>0</MeatAmount>
            <Mass>2</Mass>
        </statBases>
        <tools>
            <li>
                <label>bite</label>
                <capacities>
                    <li>Bite</li>
                </capacities>
                <power>3</power>
                <cooldownTime>1.6</cooldownTime>
                <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
            </li>
        </tools>
        <comps>
            <li Class="GateRimSG1.Goauld.CompProperties_GoauldForcedImplantation">
                <minimumTargetAgeYears>13</minimumTargetAgeYears>
                <symbioteOrigin>Tokra</symbioteOrigin>
                <allowForcedImplantation>false</allowForcedImplantation>
                <allowRitualImplantation>false</allowRitualImplantation>
                <allowAutonomousHuntToggle>false</allowAutonomousHuntToggle>
                <allowVoluntaryImplantation>true</allowVoluntaryImplantation>
                <voluntaryImplantationRange>12</voluntaryImplantationRange>
                <autonomousHuntingEnabled>false</autonomousHuntingEnabled>
                <autonomousScanIntervalTicks>60</autonomousScanIntervalTicks>
                <autonomousSearchRadius>35</autonomousSearchRadius>
                <autonomousCooldownAfterExtractionTicks>2500</autonomousCooldownAfterExtractionTicks>
                <ritualImplantationRange>12</ritualImplantationRange>
                <ritualCeremonyDurationTicks>600</ritualCeremonyDurationTicks>
                <ritualBasinRange>6</ritualBasinRange>
            </li>
        </comps>
        <race>
            <body>Snake</body>
            <baseBodySize>0.15</baseBodySize>
            <baseHungerRate>0.12</baseHungerRate>
            <baseHealthScale>0.35</baseHealthScale>
            <foodType>CarnivoreAnimal</foodType>
            <leatherDef>Leather_Plain</leatherDef>
            <lifeExpectancy>40</lifeExpectancy>
            <hasGenders>false</hasGenders>
            <lifeStageAges>
                <li>
                    <def>AnimalAdult</def>
                    <minAge>0</minAge>
                </li>
            </lifeStageAges>
            <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
            <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
            <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
        </race>
    </ThingDef>
</Defs>
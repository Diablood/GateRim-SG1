<?xml version='1.0' encoding='utf-8'?>
<Defs>
    <ThingDef ParentName="AnimalThingBase">
        <defName>SG1_GoauldSymbiote</defName>
        <label>Goa'uld symbiote</label>
        <description>An adult Goa'uld symbiote outside a host. It now searches for nearby compatible humanoids, pursues them and begins implantation automatically on contact. Manual forced implantation remains available for testing. After extraction, autonomous hunting pauses briefly to prevent immediate re-implantation of the patient.</description>
        <statBases>
            <MoveSpeed>4.8</MoveSpeed>
            <MarketValue>250</MarketValue>
            <ComfyTemperatureMin>0</ComfyTemperatureMin>
            <ComfyTemperatureMax>45</ComfyTemperatureMax>
            <LeatherAmount>0</LeatherAmount>
            <MeatAmount>0</MeatAmount>
            <Mass>2</Mass>
        </statBases>
        <tools>
            <li>
                <label>bite</label>
                <capacities>
                    <li>Bite</li>
                </capacities>
                <power>3</power>
                <cooldownTime>1.6</cooldownTime>
                <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
            </li>
        </tools>
        <comps>
            <li Class="GateRimSG1.Goauld.CompProperties_GoauldForcedImplantation">
                <minimumTargetAgeYears>13</minimumTargetAgeYears>
                <autonomousHuntingEnabled>true</autonomousHuntingEnabled>
                <autonomousScanIntervalTicks>60</autonomousScanIntervalTicks>
                <autonomousSearchRadius>35</autonomousSearchRadius>
                <autonomousCooldownAfterExtractionTicks>2500</autonomousCooldownAfterExtractionTicks>
            </li>
        </comps>
        <race>
            <body>Snake</body>
            <baseBodySize>0.15</baseBodySize>
            <baseHungerRate>0.12</baseHungerRate>
            <baseHealthScale>0.35</baseHealthScale>
            <foodType>CarnivoreAnimal</foodType>
            <leatherDef>Leather_Plain</leatherDef>
            <lifeExpectancy>40</lifeExpectancy>
            <hasGenders>false</hasGenders>
            <lifeStageAges>
                <li>
                    <def>AnimalAdult</def>
                    <minAge>0</minAge>
                </li>
            </lifeStageAges>
            <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
            <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
            <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
        </race>
    </ThingDef>
</Defs>
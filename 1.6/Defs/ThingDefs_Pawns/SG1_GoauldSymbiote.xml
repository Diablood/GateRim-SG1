<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--
        XML-only prototype:
        This pawn represents an adult Goa'uld symbiote outside any host.
        It can currently be spawned for visual and balance tests through
        developer mode. Forced implantation, ritual implantation, transfer,
        extraction and host-control logic require later C# milestones.
    -->
    <ThingDef ParentName="AnimalThingBase">
        <defName>SG1_GoauldSymbiote</defName>
        <label>Goa'uld symbiote</label>
        <description>An adult Goa'uld symbiote outside a host. In this prototype, it is a small and vulnerable creature that can be spawned for testing. Future milestones will allow it to attack a humanoid target, begin an implantation process and take control of a suitable host.</description>
        <statBases>
            <MoveSpeed>4.8</MoveSpeed>
            <MarketValue>250</MarketValue>
            <ComfyTemperatureMin>0</ComfyTemperatureMin>
            <ComfyTemperatureMax>45</ComfyTemperatureMax>
            <LeatherAmount>0</LeatherAmount>
            <MeatAmount>0</MeatAmount>
            <Mass>2</Mass>
        </statBases>
        <tools>
            <li>
                <label>bite</label>
                <capacities>
                    <li>Bite</li>
                </capacities>
                <power>3</power>
                <cooldownTime>1.6</cooldownTime>
                <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
            </li>
        </tools>
        <race>
            <body>Snake</body>
            <baseBodySize>0.15</baseBodySize>
            <baseHungerRate>0.12</baseHungerRate>
            <baseHealthScale>0.35</baseHealthScale>
            <foodType>CarnivoreAnimal</foodType>
            <leatherDef>Leather_Plain</leatherDef>
            <lifeExpectancy>40</lifeExpectancy>
            <wildness>1</wildness>
            <hasGenders>false</hasGenders>
            <lifeStageAges>
                <li>
                    <def>AnimalAdult</def>
                    <minAge>0</minAge>
                </li>
            </lifeStageAges>
            <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
            <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
            <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
        </race>
    </ThingDef>
</Defs>

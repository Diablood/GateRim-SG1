    <ThingDef ParentName="SG1_SGTeamPantsBase">
        <defName>SG1_OliveSGTeamPants</defName>
        <label>olive SG-team field pants</label>
        <description>Olive-drab field trousers used by SG teams. They form the mandatory lower half of the modular field uniform and can be combined with a T-shirt, field jacket and tactical vest.</description>
        <graphicData>
            <texPath>Things/Pawn/Humanlike/Apparel/SGTeamPantsOlive/SGTeamPantsOlive</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <apparel>
            <wornGraphicPath>Things/Pawn/Humanlike/Apparel/SGTeamPantsOlive/SGTeamPantsOlive</wornGraphicPath>
        </apparel>
    </ThingDef>


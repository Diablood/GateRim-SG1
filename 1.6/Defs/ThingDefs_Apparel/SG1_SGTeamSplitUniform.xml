<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef Name="SG1_SGTeamPantsBase" ParentName="ApparelMakeableBase" Abstract="True">
        <techLevel>Industrial</techLevel>
        <tradeability>Sellable</tradeability>
        <generateCommonality>0.08</generateCommonality>
        <thingCategories Inherit="False">
            <li>SG1_SGTeamApparel</li>
        </thingCategories>
        <costList>
            <Cloth>40</Cloth>
        </costList>
        <statBases>
            <WorkToMake>3000</WorkToMake>
            <MaxHitPoints>100</MaxHitPoints>
            <Mass>0.8</Mass>
            <Flammability>1</Flammability>
            <ArmorRating_Sharp>0.04</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.02</ArmorRating_Blunt>
            <ArmorRating_Heat>0.05</ArmorRating_Heat>
            <EquipDelay>1</EquipDelay>
        </statBases>
        <recipeMaker>
            <researchPrerequisite>SG1_SGFieldEquipment</researchPrerequisite>
            <skillRequirements>
                <Crafting>3</Crafting>
            </skillRequirements>
            <recipeUsers>
                <li>HandTailoringBench</li>
                <li>ElectricTailoringBench</li>
            </recipeUsers>
        </recipeMaker>
        <apparel>
            <bodyPartGroups>
                <li>Legs</li>
            </bodyPartGroups>
            <layers>
                <li>OnSkin</li>
            </layers>
            <tags>
                <li>IndustrialAdvanced</li>
                <li>SG1_SGTeamUniform</li>
            </tags>
            <defaultOutfitTags>
                <li>Worker</li>
                <li>Soldier</li>
            </defaultOutfitTags>
        </apparel>
    </ThingDef>


<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--
    Modular Jaffa armor prototypes.
    Torso armor uses Shell. Gauntlets and boots use Middle. The deployed helmet
    uses Overhead and FullHead. Retractable visual modes are intentionally
    deferred to a later C# milestone.
    -->
    <ThingDef ParentName="ArmorMachineableBase">
        <defName>SG1_JaffaLightArmor</defName>
        <label>light Jaffa armor</label>
        <description>A modular light armor worn by Goa'uld-aligned Jaffa warriors. Its plated torso and shoulder protection favors mobility while offering useful resistance to energy heat. Separate gauntlets and reinforced boots complete the intended battlefield loadout.</description>
        <graphicData>
            <texPath>Things/Pawn/Humanlike/Apparel/JaffaLightArmor/JaffaLightArmor</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <techLevel>Spacer</techLevel>
        <tradeability>Sellable</tradeability>
        <generateCommonality>0.15</generateCommonality>
        <thingCategories Inherit="False">
            <li>SG1_JaffaApparel</li>
        </thingCategories>
        <costList>
            <Steel>70</Steel>
            <Plasteel>20</Plasteel>
            <ComponentIndustrial>2</ComponentIndustrial>
        </costList>
        <statBases>
            <WorkToMake>16000</WorkToMake>
            <MaxHitPoints>240</MaxHitPoints>
            <Mass>6.5</Mass>
            <Flammability>0</Flammability>
            <ArmorRating_Sharp>0.68</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.28</ArmorRating_Blunt>
            <ArmorRating_Heat>0.42</ArmorRating_Heat>
            <EquipDelay>9</EquipDelay>
        </statBases>
        <equippedStatOffsets>
            <MoveSpeed>-0.06</MoveSpeed>
        </equippedStatOffsets>
        <recipeMaker>
            <researchPrerequisite>Gunsmithing</researchPrerequisite>
            <skillRequirements>
                <Crafting>6</Crafting>
            </skillRequirements>
        </recipeMaker>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Neck</li>
                <li>Shoulders</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Pawn/Humanlike/Apparel/JaffaLightArmor/JaffaLightArmor</wornGraphicPath>
            <layers>
                <li>Shell</li>
            </layers>
            <tags>
                <li>SG1_JaffaArmorLight</li>
            </tags>
            <defaultOutfitTags>
                <li>Soldier</li>
            </defaultOutfitTags>
            <useDeflectMetalEffect>true</useDeflectMetalEffect>
        </apparel>
    </ThingDef>


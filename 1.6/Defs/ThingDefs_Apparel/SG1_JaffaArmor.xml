            <tags>
                <li>SG1_JaffaArmorHeavy</li>
            </tags>
            <defaultOutfitTags>
                <li>Soldier</li>
            </defaultOutfitTags>
            <useDeflectMetalEffect>true</useDeflectMetalEffect>
        </apparel>
    </ThingDef>


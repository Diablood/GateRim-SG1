    <ThingDef ParentName="ArmorHelmetMakeableBase">
        <defName>SG1_JaffaDeployedHelmet</defName>
        <label>deployed Jaffa helmet</label>
        <description>A fully deployed Jaffa helmet protecting the entire head and face. This static prototype prepares a later retractable version: the future retracted mode will preserve the same raw armor ratings while reducing coverage from the full head to the upper head.</description>

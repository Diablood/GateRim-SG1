<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="ApparelMakeableBase">
        <defName>SG1_TokraFieldGarb</defName>
        <label>Tok'ra field garb</label>
        <description>A sober sand-colored Tok'ra field outfit for clandestine meetings and safehouse duty. Its quilted tunic, structured shoulders and visible belt are ceremonial enough to read as Tok'ra without functioning as combat armor.</description>
        <graphicData>
            <texPath>Things/Pawn/Humanlike/Apparel/TokraFieldGarb/TokraFieldGarb</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <techLevel>Industrial</techLevel>
        <tradeability>Sellable</tradeability>
        <generateCommonality>0.03</generateCommonality>
        <thingCategories Inherit="False">
            <li>Apparel</li>
        </thingCategories>
        <costList>
            <Cloth>80</Cloth>
        </costList>
        <statBases>
            <WorkToMake>5500</WorkToMake>
            <MaxHitPoints>120</MaxHitPoints>
            <Mass>1.5</Mass>
            <Flammability>1</Flammability>
            <ArmorRating_Sharp>0.06</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.04</ArmorRating_Blunt>
            <ArmorRating_Heat>0.08</ArmorRating_Heat>
            <EquipDelay>2</EquipDelay>
        </statBases>
        <recipeMaker>
            <researchPrerequisite>SG1_SGFieldEquipment</researchPrerequisite>
            <skillRequirements>
                <Crafting>3</Crafting>
            </skillRequirements>
            <recipeUsers>
                <li>HandTailoringBench</li>
                <li>ElectricTailoringBench</li>
            </recipeUsers>
        </recipeMaker>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Neck</li>
                <li>Shoulders</li>
                <li>Arms</li>
                <li>Legs</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Pawn/Humanlike/Apparel/TokraFieldGarb/TokraFieldGarb</wornGraphicPath>
            <layers>
                <li>OnSkin</li>
            </layers>
            <tags>
                <li>IndustrialAdvanced</li>
                <li>SG1_TokraFieldGarb</li>
            </tags>
            <defaultOutfitTags>
                <li>Worker</li>
            </defaultOutfitTags>
        </apparel>
    </ThingDef>
</Defs>

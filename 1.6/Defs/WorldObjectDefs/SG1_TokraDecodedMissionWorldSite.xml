<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <WorldObjectDef>
        <defName>SG1_TokraDecodedMissionWorldSite</defName>
        <label>Tok'ra decoded mission site</label>
        <description>A temporary mission marker representing the isolated Goa'uld relay identified from decoded Tok'ra intelligence. A player caravan can launch a playable sabotage operation from this site.</description>
        <worldObjectClass>GateRimSG1.Goauld.WorldObject_TokraDecodedMissionSite</worldObjectClass>
        <texture>World/WorldObjects/Sites/GenericSite</texture>
        <expandingIcon>true</expandingIcon>
        <expandingIconTexture>World/WorldObjects/Expanding/Sites/SG1_GoauldRelaySabotage</expandingIconTexture>
        <expandingIconPriority>36</expandingIconPriority>
        <expandMore>true</expandMore>
        <canHaveFaction>true</canHaveFaction>
        <useDynamicDrawer>true</useDynamicDrawer>
        <comps>
            <li Class="GateRimSG1.Goauld.WorldObjectCompProperties_TokraRelayFormCaravan" />
        </comps>
    </WorldObjectDef>
</Defs>

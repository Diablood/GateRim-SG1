        <thingClass>GateRimSG1.Goauld.Building_TokraOrganicDeadDrop</thingClass>
        <minifiedDef IsNull="True" />
        <graphicData>
            <texPath>Things/Item/SG1_TokraMissionIntelPacket</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(0.85,0.85)</drawSize>
        </graphicData>
        <size>(1,1)</size>
        <rotatable>false</rotatable>
        <altitudeLayer>Building</altitudeLayer>
        <passability>Standable</passability>
        <fillPercent>0.10</fillPercent>
        <pathCost>5</pathCost>
        <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
        <statBases>
            <MaxHitPoints>80</MaxHitPoints>
            <WorkToBuild>0</WorkToBuild>
            <Mass>8</Mass>
            <MarketValue>0</MarketValue>
            <Beauty>0</Beauty>
            <Flammability>0.20</Flammability>
        </statBases>
        <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
        <thingCategories Inherit="False" />
        <comps>
            <li Class="GateRimSG1.Goauld.CompProperties_TokraOrganicDeadDrop" />
        </comps>
    </ThingDef>
</Defs>

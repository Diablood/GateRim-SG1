<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="FurnitureBase">
        <defName>SG1_TokraObservationPoint</defName>
        <label>Tok'ra observation point</label>
        <description>A peripheral position selected by the Tok'ra cell for a discreet field watch. Once the delivered sensor is installed here, an operator must remain at the scope to conduct the field watch before packing it up and returning it directly to the secure communicator.</description>
        <thingClass>GateRimSG1.Goauld.Building_TokraObservationPoint</thingClass>
        <designationCategory IsNull="True" />
        <minifiedDef IsNull="True" />
        <graphicData>
            <texPath>Things/Building/SG1_TokraObservationPoint/SG1_TokraObservationPoint</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(1.1,1.1)</drawSize>
        </graphicData>
        <size>(1,1)</size>
        <rotatable>false</rotatable>
        <altitudeLayer>Building</altitudeLayer>
        <passability>Standable</passability>
        <fillPercent>0</fillPercent>
        <pathCost>0</pathCost>
        <useHitPoints>true</useHitPoints>
        <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
        <statBases>
            <MaxHitPoints>50</MaxHitPoints>
            <WorkToBuild>0</WorkToBuild>
            <Mass>0</Mass>
            <Beauty>0</Beauty>
            <Flammability>0</Flammability>
        </statBases>
        <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
        <thingCategories Inherit="False" />
        <comps>
            <li Class="GateRimSG1.Goauld.CompProperties_TokraObservationPoint" />
        </comps>
    </ThingDef>
</Defs>

        <description>A discreet encrypted Tok'ra communication station. It establishes a trusted contact channel and can request a rare defensive diversion during an active attack without enabling trade, recruitment, quests or permanent military aid.</description>
        <graphicData>
            <texPath>Things/Building/SG1_TokraSecureCommunicator</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(1,1)</drawSize>
        </graphicData>
        <size>(1,1)</size>
        <rotatable>false</rotatable>
        <tickerType>Normal</tickerType>
        <fillPercent>0.35</fillPercent>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <pathCost>25</pathCost>
        <statBases>
            <MaxHitPoints>120</MaxHitPoints>
            <WorkToBuild>900</WorkToBuild>
            <Mass>12</Mass>
            <Beauty>0</Beauty>
            <Flammability>0.3</Flammability>
        </statBases>
        <costList>
            <Steel>40</Steel>
            <ComponentIndustrial>2</ComponentIndustrial>
            <Gold>2</Gold>
        </costList>
        <designationCategory>Misc</designationCategory>
        <researchPrerequisites>
            <li>MicroelectronicsBasics</li>
        </researchPrerequisites>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>40</basePowerConsumption>
            </li>
            <li Class="CompProperties_Flickable" />
            <li Class="GateRimSG1.Goauld.CompProperties_TokraSecureCommunicator" />
        </comps>
        <minifiedDef>MinifiedThing</minifiedDef>
    </ThingDef>

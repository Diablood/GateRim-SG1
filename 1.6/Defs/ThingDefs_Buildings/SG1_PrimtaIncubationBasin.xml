<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--
    Queen-origin assisted-maturation prototype.

    The basin now consumes one physical immature symbiote extracted from a
    Goa'uld queen and 10 units of raw meat nutrients to mature one physical
    Prim'ta larva. Autonomous queen reproduction remains a future milestone.
    -->
    <ThingDef ParentName="BenchBase">
        <defName>SG1_PrimtaIncubationBasin</defName>
        <label>Prim'ta incubation basin</label>
        <description>A controlled biological basin used for assisted maturation of queen-origin immature Goa'uld symbiotes into physical Prim'ta larvae. One immature symbiote and 10 units of raw meat nutrients are required for each transportable larva.</description>
        <thingClass>Building_WorkTable</thingClass>
        <graphicData>
            <texPath>Things/Building/SG1_PrimtaIncubationBasin</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2,1)</drawSize>
        </graphicData>
        <size>(2,1)</size>
        <rotatable>true</rotatable>
        <fillPercent>0.5</fillPercent>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <pathCost>50</pathCost>
        <hasInteractionCell>true</hasInteractionCell>
        <interactionCellOffset>(0,0,-1)</interactionCellOffset>
        <surfaceType>Item</surfaceType>
        <statBases>
            <MaxHitPoints>220</MaxHitPoints>
            <WorkToBuild>1600</WorkToBuild>
            <Mass>35</Mass>
            <Beauty>2</Beauty>
            <Flammability>0.2</Flammability>
        </statBases>
        <costList>
            <Steel>80</Steel>
            <Gold>8</Gold>
        </costList>
        <designationCategory>Production</designationCategory>
        <inspectorTabs>
            <li>ITab_Bills</li>
        </inspectorTabs>
        <building>
            <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
        </building>
        <recipes>
            <li>SG1_IncubatePrimtaLarva</li>
        </recipes>
        <minifiedDef>MinifiedThing</minifiedDef>
    </ThingDef>
</Defs>

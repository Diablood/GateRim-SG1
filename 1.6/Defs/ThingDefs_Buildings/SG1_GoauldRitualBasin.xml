<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <DesignatorDropdownGroupDef>
        <defName>SG1_GoauldRitualBasins</defName>
    </DesignatorDropdownGroupDef>

    <ThingDef Name="SG1_GoauldRitualBasinBase" ParentName="FurnitureBase" Abstract="True">
        <description>A ceremonial basin used to prepare controlled Goa'uld implantation rituals and formal Jaffa Prim'ta ceremonies. Adult free-symbiote rituals require the symbiote and selected host to remain close to the basin. Jaffa ceremonies consume one nearby physical Prim'ta larva after a timed rite.</description>
        <graphicData>
            <texPath>Things/Building/SG1_GoauldRitualBasin</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2,2)</drawSize>
            <drawRotated>false</drawRotated>
        </graphicData>
        <uiIconPath>Things/Building/SG1_GoauldRitualBasin</uiIconPath>
        <rotatable>false</rotatable>
        <tickerType>Normal</tickerType>
        <statBases>
            <MaxHitPoints>180</MaxHitPoints>
            <WorkToBuild>1200</WorkToBuild>
            <Mass>18</Mass>
            <Beauty>3</Beauty>
            <Flammability>0.2</Flammability>
        </statBases>
        <costList>
            <Steel>60</Steel>
            <Gold>5</Gold>
        </costList>
        <designationCategory>Furniture</designationCategory>
        <designatorDropdown>SG1_GoauldRitualBasins</designatorDropdown>
        <researchPrerequisites>
            <li>SG1_GoauldBiotechnology</li>
        </researchPrerequisites>
        <minifiedDef>MinifiedThing</minifiedDef>
        <comps>
            <li Class="GateRimSG1.Jaffa.CompProperties_JaffaPrimtaCeremony">
                <ceremonyRange>6</ceremonyRange>
                <ceremonyDurationTicks>600</ceremonyDurationTicks>
            </li>
        </comps>
    </ThingDef>

    <ThingDef ParentName="SG1_GoauldRitualBasinBase">
        <defName>SG1_GoauldRitualBasin</defName>
        <label>Goa'uld ritual basin 2×2</label>
        <size>(2,2)</size>
    </ThingDef>

    <ThingDef ParentName="SG1_GoauldRitualBasinBase">
        <defName>SG1_GoauldRitualBasinLarge</defName>
        <label>Goa'uld ritual basin 3×3</label>
        <size>(3,3)</size>
    </ThingDef>

</Defs>

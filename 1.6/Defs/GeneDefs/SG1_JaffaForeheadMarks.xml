<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--
    Legacy migration placeholders only.

    These technical genes deliberately have no render-node properties and are
    no longer assigned by the Jaffa xenotype. They remain declared so saves
    created during the 0.1.73-dev / early 0.1.74-dev prototypes can load and
    migrate their existing genes into intrinsic pawn data without missing-Def
    errors. GameComponent_JaffaForeheadMarks removes them from encountered
    pawns after conversion.
    -->
    <GeneDef>
        <defName>SG1_JaffaForeheadMark_Generic</defName>
        <label>legacy generic Jaffa forehead-mark migration gene</label>
        <labelShortAdj>legacy marked</labelShortAdj>
        <description>Legacy migration placeholder. GateRim SG-1 converts this former technical cosmetic gene into intrinsic pawn data and removes it from affected pawns.</description>
        <iconPath>Genes/Icons/SG1_JaffaForeheadMark_Generic</iconPath>
        <biostatCpx>0</biostatCpx>
        <biostatMet>0</biostatMet>
        <canGenerateInGeneSet>false</canGenerateInGeneSet>
        <passOnDirectly>false</passOnDirectly>
        <selectionWeight>0</selectionWeight>
    </GeneDef>

    <GeneDef>
        <defName>SG1_JaffaForeheadMark_GenericSilver</defName>
        <label>legacy generic silver Jaffa forehead-mark migration gene</label>
        <labelShortAdj>legacy silver-marked</labelShortAdj>
        <description>Legacy migration placeholder. GateRim SG-1 converts this former technical cosmetic gene into intrinsic pawn data and removes it from affected pawns.</description>
        <iconPath>Genes/Icons/SG1_JaffaForeheadMark_GenericSilver</iconPath>
        <biostatCpx>0</biostatCpx>
        <biostatMet>0</biostatMet>
        <canGenerateInGeneSet>false</canGenerateInGeneSet>
        <passOnDirectly>false</passOnDirectly>
        <selectionWeight>0</selectionWeight>
    </GeneDef>

    <GeneDef>
        <defName>SG1_JaffaForeheadMark_GenericGold</defName>

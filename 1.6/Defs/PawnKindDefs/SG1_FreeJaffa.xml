<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--
    Free Jaffa pawn kinds.

    They share the existing Jaffa lineage, Prim'ta provisioning, Ma'Tok
    weapon tags and modular armor baseline, but they do not belong to a
    Goa'uld System Lord domain and therefore receive no automatic forehead
    mark.
    -->
    <PawnKindDef ParentName="BasePlayerPawnKind">
        <defName>SG1_FreeJaffaWarrior</defName>
        <label>Free Jaffa warrior</label>
        <race>Human</race>
        <defaultFactionType>SG1_FreeJaffa</defaultFactionType>
        <useFactionXenotypes>false</useFactionXenotypes>
        <xenotypeSet>
            <xenotypeChances>
                <SG1_Jaffa>999</SG1_Jaffa>
            </xenotypeChances>
        </xenotypeSet>
        <combatPower>100</combatPower>
        <isFighter>true</isFighter>
        <initialResistanceRange>0~0</initialResistanceRange>
        <weaponMoney>2000~2000</weaponMoney>
        <weaponTags>
            <li>SG1_MatokStaff</li>
        </weaponTags>
        <apparelMoney>0</apparelMoney>
        <apparelRequired Inherit="False">
            <li>SG1_JaffaLightArmor</li>
            <li>SG1_JaffaGauntlets</li>
            <li>SG1_JaffaReinforcedBoots</li>
            <li>SG1_JaffaDeployedHelmet</li>
        </apparelRequired>
        <minGenerationAge>18</minGenerationAge>
        <maxGenerationAge>60</maxGenerationAge>
    </PawnKindDef>

    <PawnKindDef ParentName="BasePlayerPawnKind">
        <defName>SG1_FreeJaffaGuard</defName>
        <label>Free Jaffa guard</label>
        <race>Human</race>
        <defaultFactionType>SG1_FreeJaffa</defaultFactionType>
        <useFactionXenotypes>false</useFactionXenotypes>
        <xenotypeSet>
            <xenotypeChances>
                <SG1_Jaffa>999</SG1_Jaffa>
            </xenotypeChances>
        </xenotypeSet>
        <combatPower>145</combatPower>
        <isFighter>true</isFighter>
        <initialResistanceRange>0~0</initialResistanceRange>
        <weaponMoney>2000~2000</weaponMoney>
        <weaponTags>
            <li>SG1_MatokStaff</li>
        </weaponTags>
        <apparelMoney>0</apparelMoney>
        <apparelRequired Inherit="False">
            <li>SG1_JaffaHeavyArmor</li>
            <li>SG1_JaffaGauntlets</li>
            <li>SG1_JaffaReinforcedBoots</li>
            <li>SG1_JaffaDeployedHelmet</li>
        </apparelRequired>
        <minGenerationAge>20</minGenerationAge>
        <maxGenerationAge>65</maxGenerationAge>
    </PawnKindDef>
</Defs>

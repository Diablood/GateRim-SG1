<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="BaseBullet">
        <defName>SG1_BolasProjectile</defName>
        <label>bolas</label>
        <thingClass>GateRimSG1.Weapons.Projectile_NonLethalCapture</thingClass>
        <graphicData>
            <texPath>Things/Projectile/SG1_BolasProjectile</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>0.55</drawSize>
        </graphicData>
        <projectile>
            <damageDef>Blunt</damageDef>
            <damageAmountBase>3</damageAmountBase>
            <armorPenetrationBase>0</armorPenetrationBase>
            <speed>24</speed>
        </projectile>
        <modExtensions>
            <li Class="GateRimSG1.Weapons.NonLethalCaptureProjectileExtension">
                <neutralizationHediff>SG1_BolasRestraint</neutralizationHediff>
                <baseNeutralizationChance>0.66</baseNeutralizationChance>
                <minimumNeutralizationChance>0.08</minimumNeutralizationChance>
                <maximumNeutralizationChance>0.82</maximumNeutralizationChance>
                <bodySizePenaltyPerPoint>0.18</bodySizePenaltyPerPoint>
                <armorStat>ArmorRating_Blunt</armorStat>
                <armorResistanceFactor>0.32</armorResistanceFactor>
                <neutralizationTicks>600~900</neutralizationTicks>
            </li>
        </modExtensions>
    </ThingDef>

    <ThingDef ParentName="BaseHumanMakeableGun">
        <defName>SG1_Bolas</defName>
        <label>bolas</label>
        <description>A weighted restraint thrown around a living target. A clean hit can briefly entangle a humanlike opponent's legs and bring them down without suppressing consciousness, but the target may resist through size, armor or simple bad luck. The bolas are consumed when thrown.</description>
        <graphicData>
            <texPath>Things/Item/Equipment/WeaponRanged/SG1_Bolas</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>0.72</drawSize>
        </graphicData>
        <techLevel>Neolithic</techLevel>
        <tradeability>Sellable</tradeability>
        <statBases>
            <WorkToMake>900</WorkToMake>
            <Mass>0.8</Mass>
            <AccuracyTouch>0.85</AccuracyTouch>
            <AccuracyShort>0.74</AccuracyShort>
            <AccuracyMedium>0.48</AccuracyMedium>
            <AccuracyLong>0.12</AccuracyLong>
            <RangedWeapon_Cooldown>2.6</RangedWeapon_Cooldown>
        </statBases>
        <costList>
            <Cloth>15</Cloth>
            <Steel>8</Steel>
        </costList>
        <recipeMaker>
            <skillRequirements>
                <Crafting>2</Crafting>
            </skillRequirements>
            <recipeUsers>
                <li>CraftingSpot</li>
                <li>FueledSmithy</li>
                <li>ElectricSmithy</li>
            </recipeUsers>
        </recipeMaker>
        <verbs>
            <li>
                <verbClass>GateRimSG1.Weapons.Verb_Shoot_ConsumableCharges</verbClass>
                <isPrimary>true</isPrimary>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>SG1_BolasProjectile</defaultProjectile>
                <warmupTime>0.85</warmupTime>
                <range>11.9</range>
                <soundCast>Bow_Shot</soundCast>
            </li>
        </verbs>
        <weaponTags>
            <li>SG1_NonLethalCapture</li>
        </weaponTags>
        <comps>
            <li Class="GateRimSG1.Weapons.CompProperties_ConsumableCharges">
                <maxCharges>1</maxCharges>
                <destroyOnEmpty>true</destroyOnEmpty>
                <chargeNoun>charge</chargeNoun>
            </li>
        </comps>
        <tools>
            <li>
                <label>weighted cord</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>3</power>
                <cooldownTime>2.3</cooldownTime>
            </li>
        </tools>
    </ThingDef>


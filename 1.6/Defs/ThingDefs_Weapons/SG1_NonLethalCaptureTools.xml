    <ThingDef ParentName="BaseHumanMakeableGun">
        <defName>SG1_TokraHypodermicRifle</defName>
        <label>experimental Tok'ra hypodermic rifle</label>
        <description>An experimental Tok'ra capture weapon carrying twelve sealed hypodermic charges. Each shot consumes one charge whether it hits or not. A successful dart can briefly numb the target's legs and bring them down without suppressing consciousness, but accuracy, armor and biological resistance still make every attempt uncertain. The weapon cannot be recharged and automatically neutralizes itself when its final charge is spent.</description>
        <graphicData>
            <texPath>Things/Item/Equipment/WeaponRanged/SG1_TokraHypodermicRifle</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>1.05</drawSize>
        </graphicData>
        <techLevel>Spacer</techLevel>
        <tradeability>None</tradeability>
        <smeltable>false</smeltable>
        <recipeMaker IsNull="True" />
        <statBases>
            <MarketValue>650</MarketValue>
            <Mass>2.1</Mass>
            <AccuracyTouch>0.82</AccuracyTouch>
            <AccuracyShort>0.88</AccuracyShort>
            <AccuracyMedium>0.74</AccuracyMedium>
            <AccuracyLong>0.48</AccuracyLong>
            <RangedWeapon_Cooldown>2.1</RangedWeapon_Cooldown>
        </statBases>
        <verbs>
            <li>
                <verbClass>GateRimSG1.Weapons.Verb_Shoot_ConsumableCharges</verbClass>
                <isPrimary>true</isPrimary>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>SG1_TokraHypodermicDart</defaultProjectile>
                <warmupTime>0.7</warmupTime>
                <range>24.9</range>
                <soundCast>Shot_Revolver</soundCast>
                <soundCastTail>GunTail_Light</soundCastTail>
                <muzzleFlashScale>1</muzzleFlashScale>
            </li>
        </verbs>
        <weaponTags>
            <li>SG1_NonLethalCapture</li>
            <li>SG1_TokraExperimental</li>
        </weaponTags>
        <comps>
            <li Class="GateRimSG1.Weapons.CompProperties_ConsumableCharges">
                <maxCharges>12</maxCharges>
                <destroyOnEmpty>true</destroyOnEmpty>
                <chargeNoun>charge</chargeNoun>
            </li>
        </comps>
        <tools>
            <li>
                <label>stock</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>5</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>
    </ThingDef>
</Defs>

        <graphicData>
            <texPath>Things/Projectile/SG1_TokraHypodermicDart</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>0.38</drawSize>
        </graphicData>
        <projectile>
            <damageDef>Blunt</damageDef>
            <damageAmountBase>1</damageAmountBase>
            <armorPenetrationBase>0</armorPenetrationBase>
            <speed>72</speed>
        </projectile>
        <modExtensions>
            <li Class="GateRimSG1.Weapons.NonLethalCaptureProjectileExtension">
                <neutralizationHediff>SG1_NonLethalNeutralization</neutralizationHediff>
                <baseNeutralizationChance>0.82</baseNeutralizationChance>
                <minimumNeutralizationChance>0.12</minimumNeutralizationChance>
                <maximumNeutralizationChance>0.92</maximumNeutralizationChance>

<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef>
        <defName>SG1_TokraObservationDevice</defName>
        <label>Tok'ra observation device</label>
        <description>A foldable Tok'ra field scope designed for a discreet observation operation. Its crystalline optics and compact sensors must be carried to the marked peripheral position and installed there. The operator remains at the device throughout the watch, then folds it up and carries it directly to a powered secure communicator.</description>
        <thingClass>GateRimSG1.Goauld.Thing_TokraObservationDevice</thingClass>
        <category>Item</category>
        <drawerType>RealtimeOnly</drawerType>
        <graphicData>
            <texPath>Things/Item/SG1_TokraObservationDevice</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(0.75,0.75)</drawSize>
        </graphicData>
        <altitudeLayer>Item</altitudeLayer>
        <useHitPoints>true</useHitPoints>
        <selectable>true</selectable>
        <alwaysHaulable>false</alwaysHaulable>
        <rotatable>false</rotatable>
        <stackLimit>1</stackLimit>
        <pathCost>10</pathCost>
        <statBases>
            <MaxHitPoints>65</MaxHitPoints>
            <Mass>6</Mass>
            <MarketValue>0</MarketValue>
            <Flammability>0.25</Flammability>
        </statBases>
        <comps>
            <li Class="GateRimSG1.Goauld.CompProperties_TokraObservationDevice" />
        </comps>
    </ThingDef>
</Defs>

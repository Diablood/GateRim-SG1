<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef>
        <defName>SG1_TokraObservationDevice</defName>
        <label>Tok'ra observation device</label>
        <description>A compact Tok'ra field sensor delivered for a discreet observation operation. It must be carried to the marked peripheral position and installed there. The operator remains at the deployed scope for the observation, then packs it up and carries it directly to a powered secure communicator.</description>
        <thingClass>GateRimSG1.Goauld.Thing_TokraObservationDevice</thingClass>
        <category>Item</category>
        <drawerType>MapMeshOnly</drawerType>
        <graphicData>
            <texPath>Things/Item/SG1_TokraMissionIntelPacket</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(0.75,0.75)</drawSize>
        </graphicData>
        <altitudeLayer>Item</altitudeLayer>
        <useHitPoints>true</useHitPoints>
        <selectable>true</selectable>
        <alwaysHaulable>false</alwaysHaulable>
        <rotatable>false</rotatable>
        <stackLimit>1</stackLimit>
        <pathCost>10</pathCost>
        <statBases>
            <MaxHitPoints>65</MaxHitPoints>
            <Mass>6</Mass>
            <MarketValue>0</MarketValue>
            <Flammability>0.25</Flammability>
        </statBases>
        <comps>
            <li Class="GateRimSG1.Goauld.CompProperties_TokraObservationDevice" />
        </comps>
    </ThingDef>
</Defs>

<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="ResourceBase">
        <defName>SG1_ImmaturePrimtaSymbiote</defName>
        <label>immature Prim'ta symbiote</label>
        <description>A fragile queen-origin immature Goa'uld symbiote. It must be matured in a Prim'ta incubation basin with raw meat nutrients before implantation into a Jaffa. A powered Prim'ta preservation basin suspends further deterioration without repairing existing spoilage. Outside a basin, prolonged storage below -15 °C accumulates deep-freezing damage and critical cold below -30 °C is more dangerous.</description>
        <thingClass>ThingWithComps</thingClass>
        <tickerType>Rare</tickerType>
        <graphicData>
            <texPath>Things/Item/SG1_PrimtaLarva</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(0.6,0.6)</drawSize>
        </graphicData>
        <stackLimit>10</stackLimit>
        <drawGUIOverlay>true</drawGUIOverlay>
        <thingCategories>
            <li>SG1_GoauldBiologicalProducts</li>
        </thingCategories>
        <statBases>
            <MarketValue>20</MarketValue>
            <Mass>0.05</Mass>
        </statBases>
        <tradeability>Sellable</tradeability>
        <comps>
            <li Class="GateRimSG1.Jaffa.CompProperties_PrimtaBiologicalPreservation">
                <daysToRotStart>2</daysToRotStart>
                <rotDestroys>true</rotDestroys>
                <deepFreezeTemperature>-15</deepFreezeTemperature>
                <criticalDeepFreezeTemperature>-30</criticalDeepFreezeTemperature>
                <deepFreezeGraceTicks>60000</deepFreezeGraceTicks>
                <deepFreezeRecoveryRate>2</deepFreezeRecoveryRate>
                <deepFreezeRotRateMultiplier>0.25</deepFreezeRotRateMultiplier>
                <criticalDeepFreezeRotRateMultiplier>0.5</criticalDeepFreezeRotRateMultiplier>
            </li>
        </comps>
    </ThingDef>
</Defs>

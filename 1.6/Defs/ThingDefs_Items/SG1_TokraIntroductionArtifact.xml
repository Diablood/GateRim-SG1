<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="ResourceBase">
        <defName>SG1_TokraIntroductionArtifact</defName>
        <label>Tok'ra cipher module</label>
        <thingClass>ThingWithComps</thingClass>
        <description>A compact Tok'ra cipher module recovered from hostile hands. Its sealed casing protects a crystalline recognition matrix containing fragments of identification protocols and research data. Despite external damage, the device remains functional. Careful analysis at a research bench may expose enough of its architecture to establish a secure line of contact with the Tok'ra.</description>
        <graphicData>
            <texPath>Things/Item/SG1_TokraIntroductionArtifact</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(0.65,0.65)</drawSize>
        </graphicData>
        <stackLimit>1</stackLimit>
        <drawGUIOverlay>false</drawGUIOverlay>
        <thingCategories>
            <li>Manufactured</li>
        </thingCategories>
        <statBases>
            <MarketValue>1</MarketValue>
            <Mass>0.15</Mass>
        </statBases>
        <tradeability>None</tradeability>
        <comps>
            <li Class="GateRimSG1.Goauld.CompProperties_TokraCipherModuleAnalysis">
                <analysisRequiredRange>
                    <min>3</min>
                    <max>3</max>
                </analysisRequiredRange>
                <analysisDurationHours>1.2</analysisDurationHours>
                <destroyedOnAnalyzed>true</destroyedOnAnalyzed>
                <showProgress>true</showProgress>
                <allowRepeatAnalysis>false</allowRepeatAnalysis>
                <canStudyInPlace>false</canStudyInPlace>
                <activateTexPath>UI/Icons/Study</activateTexPath>
                <targetingParameters>
                    <canTargetBuildings>false</canTargetBuildings>
                    <canTargetAnimals>false</canTargetAnimals>
                    <canTargetMechs>false</canTargetMechs>
                    <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
                </targetingParameters>
            </li>
        </comps>
    </ThingDef>
</Defs>

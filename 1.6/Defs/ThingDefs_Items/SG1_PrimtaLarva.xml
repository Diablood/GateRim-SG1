<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="ResourceBase">
        <defName>SG1_PrimtaLarva</defName>
        <label>Prim'ta larva</label>
        <description>An immature Goa'uld symbiote intended for implantation into a compatible Jaffa abdominal pouch. This living biological resource must be preserved carefully. A powered Prim'ta preservation basin suspends further deterioration without repairing existing spoilage. Without a basin, refrigeration, freezing and heat continue to use the ambient-temperature preservation model.</description>
        <thingClass>ThingWithComps</thingClass>
        <tickerType>Rare</tickerType>
        <graphicData>
            <texPath>Things/Item/SG1_PrimtaLarva</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(0.8,0.8)</drawSize>
        </graphicData>
        <stackLimit>10</stackLimit>
        <drawGUIOverlay>true</drawGUIOverlay>
        <thingCategories>
            <li>SG1_GoauldBiologicalProducts</li>
        </thingCategories>
        <statBases>
            <MarketValue>35</MarketValue>
            <Mass>0.1</Mass>
        </statBases>
        <tradeability>Sellable</tradeability>
        <comps>
            <li Class="GateRimSG1.Jaffa.CompProperties_PrimtaLarvaTemperature">
                <recommendedMinTemperature>0</recommendedMinTemperature>
                <recommendedMaxTemperature>10</recommendedMaxTemperature>
                <hotTemperature>25</hotTemperature>
                <criticalTemperature>40</criticalTemperature>
                <hotRotRateMultiplier>2</hotRotRateMultiplier>
                <criticalRotRateMultiplier>3</criticalRotRateMultiplier>
            </li>
            <li Class="GateRimSG1.Jaffa.CompProperties_PrimtaBiologicalPreservation">
                <daysToRotStart>6</daysToRotStart>
                <rotDestroys>true</rotDestroys>
            </li>
        </comps>
    </ThingDef>
</Defs>

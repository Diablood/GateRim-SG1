<?xml version='1.0' encoding='utf-8'?>
<Defs>
    <ThingDef ParentName="ResourceBase">
        <defName>SG1_PrimtaLarva</defName>
        <label>Prim'ta larva</label>
        <description>An immature Goa'uld symbiote intended for implantation into a compatible Jaffa abdominal pouch. This living biological resource is stored under Goa'uld biological products rather than manufactured goods or raw food. It is consumed by the Jaffa Prim'ta implantation procedure. Warm conditions cause progressive deterioration and a fully rotted larva is destroyed.</description>
        <thingClass>ThingWithComps</thingClass>
        <tickerType>Rare</tickerType>
        <graphicData>
            <texPath>Things/Item/SG1_PrimtaLarva</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(0.8,0.8)</drawSize>
        </graphicData>
        <stackLimit>10</stackLimit>
        <drawGUIOverlay>true</drawGUIOverlay>
        <thingCategories>
            <li>SG1_GoauldBiologicalProducts</li>
        </thingCategories>
        <statBases>
            <MarketValue>35</MarketValue>
            <Mass>0.1</Mass>
        </statBases>
        <tradeability>Sellable</tradeability>
        <comps>
            <li Class="CompProperties_Rottable">
                <daysToRotStart>6</daysToRotStart>
                <rotDestroys>true</rotDestroys>
            </li>
        </comps>
    </ThingDef>
</Defs>
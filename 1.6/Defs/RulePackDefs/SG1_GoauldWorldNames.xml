                <li>femininePlaceInitial->Necropolis</li>
                <li>femininePlaceInitial->Enclave</li>
                <li>femininePlaceInitial->Capital</li>
                <li>masculinePlaceLower->Temple</li>
                <li>masculinePlaceLower->Palace</li>
                <li>masculinePlaceLower->Bastion</li>
                <li>masculinePlaceLower->Sanctum</li>
                <li>masculinePlaceLower->Fort</li>

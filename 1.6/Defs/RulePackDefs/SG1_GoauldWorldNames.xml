                <li>theme->of the Supreme Will</li>
                <li>theme->of the Chosen Blood</li>
                <li>theme->of the Iron Serpent</li>
                <li>theme->of the Star Throne</li>
                <li>theme->of the First Serpent</li>
                <li>theme->of the Golden Mask</li>
                <li>theme->of the Eternal Scarab</li>
                <li>theme->of the Celestial Eye</li>
                <li>theme->of the Crimson Moon</li>
                <li>theme->of the Silent Pyramid</li>
                <li>theme->of the Sacred Flame</li>
                <li>theme->of the Living Sun</li>
                <li>theme->of the Black Crown</li>

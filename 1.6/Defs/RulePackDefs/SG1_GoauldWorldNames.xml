                <li>femininePlaceLower->Pyramid</li>
                <li>femininePlaceLower->Necropolis</li>
                <li>femininePlaceLower->Enclave</li>
                <li>femininePlaceLower->Capital</li>
                <li>theme->of the Golden Throne</li>
                <li>theme->of the Serpent Crown</li>
                <li>theme->of the Eternal Eye</li>
                <li>theme->of the Ascendant Flame</li>

<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <SitePartDef>
        <defName>SG1_TokraHiddenSafehouseSitePart</defName>
        <label>hidden Tok'ra safehouse</label>
        <description>A temporary clandestine Tok'ra safehouse containing a modest medical cache.</description>
        <workerClass>RimWorld.Planet.SitePartWorker_ItemStash</workerClass>
        <siteTexture>World/WorldObjects/Sites/GenericSite</siteTexture>
        <expandingIconTexture>World/WorldObjects/Expanding/Sites/ItemStash</expandingIconTexture>
        <handlesWorldObjectTimeoutInspectString>true</handlesWorldObjectTimeoutInspectString>
        <requiresFaction>true</requiresFaction>
        <approachOrderString>Visit {0}</approachOrderString>
        <approachingReportString>Visiting {0}.</approachingReportString>
        <arrivedLetterLabelPart>Tok'ra safehouse</arrivedLetterLabelPart>
        <arrivedLetter>The coordinates lead to a quiet Tok'ra safehouse. No permanent cell remains here, but a modest medical cache has been left for your caravan.</arrivedLetter>
        <arrivedLetterDef>PositiveEvent</arrivedLetterDef>
        <gravShipsCanLandOn>true</gravShipsCanLandOn>
        <tags>
            <li>SG1_TokraHiddenSafehouse</li>
        </tags>
    </SitePartDef>

    <GenStepDef>
        <defName>SG1_TokraHiddenSafehouseItemStash</defName>
        <linkWithSite>SG1_TokraHiddenSafehouseSitePart</linkWithSite>
        <order>400</order>
        <genStep Class="GenStep_ItemStash">
            <count>1</count>
            <nearMapCenter>true</nearMapCenter>
        </genStep>
    </GenStepDef>
</Defs>

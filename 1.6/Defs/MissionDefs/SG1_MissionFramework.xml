<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <GateRimSG1.Missions.GateRimMissionDef>
        <defName>SG1_TokraOrganic_GoauldObservation</defName>
        <label>Tok'ra field observation</label>
        <debugLabel>Tok'ra Goa'uld observation pilot</debugLabel>
        <legacyAdapterKey>GoauldObservation</legacyAdapterKey>
        <objectiveThingDef>SG1_TokraObservationDevice</objectiveThingDef>
        <timing>
            <offerDurationTicks>120000</offerDurationTicks>
            <readyDelayTicks>0</readyDelayTicks>
            <deadlineTicks>120000</deadlineTicks>
        </timing>
        <recurrence>
            <repeatedMissionWeightFactor>0.25</repeatedMissionWeightFactor>
            <minimumDelayTicks>240000</minimumDelayTicks>
            <maximumDelayTicks>480000</maximumDelayTicks>
            <contextWeights>
                <li>
                    <contextKey>TokraTrust.Wary</contextKey>
                    <weight>0.60</weight>
                </li>
                <li>
                    <contextKey>TokraTrust.Neutral</contextKey>
                    <weight>1.00</weight>
                </li>
                <li>
                    <contextKey>TokraTrust.Cooperative</contextKey>
                    <weight>0.85</weight>
                </li>
                <li>
                    <contextKey>TokraTrust.Trusted</contextKey>
                    <weight>0.35</weight>
                </li>
            </contextWeights>
        </recurrence>
        <difficulty>
            <mode>ThreatPointsSnapshot</mode>
            <pointsFactor>1.0</pointsFactor>
            <minimumPoints>0</minimumPoints>
            <maximumPoints>100000</maximumPoints>
        </difficulty>
        <texts>
            <offerLetterLabelKey>GR_TokraOrganicOperation_OfferLetterLabel</offerLetterLabelKey>
            <offerLetterTexts>
                <li>
                    <key>GR_TokraOrganicOperation_OfferLetterText</key>
                    <weight>1</weight>
                </li>
                <li>
                    <key>GR_MissionFramework_ObservationOfferText2</key>
                    <weight>1</weight>
                </li>
                <li>
                    <key>GR_MissionFramework_ObservationOfferText3</key>
                    <weight>1</weight>
                </li>
            </offerLetterTexts>
            <offerExpiredMessageKey>GR_TokraOrganicOperation_OfferExpired</offerExpiredMessageKey>
        </texts>
        <actions>
            <acceptActionKey>GR_TokraOrganicOperation_FloatMenuAcceptObservation</acceptActionKey>
            <completeActionKey>GR_TokraOrganicOperation_FloatMenuTransmitObservation</completeActionKey>
            <offeredStatusKey>GR_TokraOrganicOperation_StatusOffered</offeredStatusKey>
            <activeStatusKey>GR_TokraOrganicOperation_StatusObserving</activeStatusKey>
            <readyStatusKey>GR_TokraOrganicOperation_StatusReady</readyStatusKey>
            <successTrustMessageKey>GR_TokraTrust_OrganicObservationSucceeded</successTrustMessageKey>
            <failureTrustMessageKey>GR_TokraTrust_OrganicObservationFailed</failureTrustMessageKey>
        </actions>
        <rewards>
            <intellectualXp>250</intellectualXp>
            <medicineXp>0</medicineXp>
            <socialXp>0</socialXp>
            <successTrustChange>3</successTrustChange>
            <failureTrustChange>-1</failureTrustChange>
        </rewards>
        <phases>
            <li>
                <id>offered</id>
                <labelKey>GR_MissionFramework_PhaseOffered</labelKey>
                <transitions>
                    <li>
                        <targetPhaseId>accepted</targetPhaseId>
                        <conditions>
                            <li>
                                <conditionType>OfferAccepted</conditionType>
                            </li>
                        </conditions>
                    </li>
                </transitions>
            </li>
            <li>
                <id>accepted</id>
                <labelKey>GR_MissionFramework_PhaseAccepted</labelKey>
                <objectives>
                    <li>
                        <objectiveType>DeployThing</objectiveType>
                        <targetDefName>SG1_TokraObservationDevice</targetDefName>
                        <requiredCount>1</requiredCount>
                    </li>
                </objectives>
                <transitions>
                    <li>
                        <targetPhaseId>deployed</targetPhaseId>
                        <conditions>
                            <li>
                                <conditionType>ObjectiveDeployed</conditionType>
                                <targetDefName>SG1_TokraObservationDevice</targetDefName>
                            </li>
                        </conditions>
                    </li>
                </transitions>
            </li>
            <li>
                <id>deployed</id>
                <labelKey>GR_MissionFramework_PhaseDeployed</labelKey>
                <objectives>
                    <li>
                        <objectiveType>OperateAtSite</objectiveType>
                    </li>
                </objectives>
                <transitions>
                    <li>
                        <targetPhaseId>observing</targetPhaseId>
                        <conditions>
                            <li>
                                <conditionType>OperatorStartedWork</conditionType>
                            </li>
                        </conditions>
                    </li>
                </transitions>
            </li>
            <li>
                <id>observing</id>
                <labelKey>GR_MissionFramework_PhaseObserving</labelKey>
                <objectives>
                    <li>
                        <objectiveType>MaintainOperator</objectiveType>
                        <workTicks>10000</workTicks>
                    </li>
                </objectives>
                <transitions>
                    <li>
                        <targetPhaseId>ready</targetPhaseId>
                        <conditions>
                            <li>
                                <conditionType>WorkCompleted</conditionType>
                            </li>
                        </conditions>
                    </li>
                </transitions>
            </li>
            <li>
                <id>ready</id>
                <labelKey>GR_MissionFramework_PhaseReady</labelKey>
                <objectives>
                    <li>
                        <objectiveType>RecoverAndTransmit</objectiveType>
                        <targetDefName>SG1_TokraObservationDevice</targetDefName>
                        <requiredCount>1</requiredCount>
                    </li>
                </objectives>
                <transitions>
                    <li>
                        <targetPhaseId>succeeded</targetPhaseId>
                        <conditions>
                            <li>
                                <conditionType>DataTransmitted</conditionType>
                            </li>
                        </conditions>
                    </li>
                    <li>
                        <targetPhaseId>failed</targetPhaseId>
                        <priority>100</priority>
                        <conditions>
                            <li>
                                <conditionType>DeadlineExpired</conditionType>
                            </li>
                        </conditions>
                    </li>
                </transitions>
            </li>
            <li>
                <id>succeeded</id>
                <labelKey>GR_MissionFramework_PhaseSucceeded</labelKey>
                <terminal>true</terminal>
                <onEnterConsequences>
                    <li>
                        <consequenceType>AdjustTokraTrust</consequenceType>
                        <value>3</value>
                    </li>
                    <li>
                        <consequenceType>GrantIntellectualXp</consequenceType>
                        <value>250</value>
                    </li>
                </onEnterConsequences>
            </li>
            <li>
                <id>failed</id>
                <labelKey>GR_MissionFramework_PhaseFailed</labelKey>
                <terminal>true</terminal>
                <onEnterConsequences>
                    <li>
                        <consequenceType>AdjustTokraTrust</consequenceType>
                        <value>-1</value>
                    </li>
                </onEnterConsequences>
            </li>
        </phases>
    </GateRimSG1.Missions.GateRimMissionDef>
</Defs>
